{
  "monitor_index": 1,
  "capture_interval_seconds": 0.25,
  "dedupe_seconds": 12.0,
  "alert_cooldown_seconds": 10.0,
  "sound_enabled": true,
  "popup_enabled": true,
  "popup_seconds": 8.0,
  "popup_icon_file": "signals_icon.png",
  "save_alert_samples": true,
  "save_debug_screenshots": false,
  "discord_enabled": false,
  "discord_webhook_file": "discord_webhook.txt",
  "discord_env_var": "DROID_DISCORD_WEBHOOK_URL",
  "ntfy_enabled": false,
  "ntfy_server_url": "https://ntfy.sh",
  "ntfy_topic": "",
  "ntfy_token_file": "ntfy_token.txt",
  "ntfy_env_token": "DROIDALERTS_NTFY_TOKEN",
  "ntfy_priority": "5",
  "ntfy_tags": "rotating_light",
  "ntfy_cache": "no",
  "ntfy_include_attachment": false,
  "notification_setup_prompted": false,
  "phone_alerts_enabled": false,
  "phone_credentials_file": "phone_alerts.json",
  "phone_env_token": "DROIDWATCHER_PHONE_ALERTS_TOKEN",
